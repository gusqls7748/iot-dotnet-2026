<Window x:Class="WpfCctvMonitorApp.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:WpfCctvMonitorApp"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        d:DesignHeight="290" d:DesignWidth="260"
        Title="LoadingWindow">

    <Border Background="#CC202020"
            CornerRadius="16" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <ui:ProgressRing Width="100" Height="100" IsIndeterminate="True" />

            <TextBlock Text="CCTV 목록을 불러오는중..."
                       Margin="0,15,0,0" Foreground="White"
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
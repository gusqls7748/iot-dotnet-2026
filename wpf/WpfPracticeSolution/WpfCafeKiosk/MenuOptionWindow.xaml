<Window x:Class="WpfCafeKiosk.MenuOptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
        xmlns:local="clr-namespace:WpfCafeKiosk"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        Title="MenuOptionWindow" Height="320" Width="350">

    <materialDesign:Card UniformCornerRadius="10" Padding="20" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="옵션 선택" FontSize="18" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Grid Grid.Row="1" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="ImgMenu" Grid.Column="0" Stretch="Uniform" Margin="5" Source="/Images/iceamericano.png"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtMenuName" Text="메뉴 이름" FontSize="18" FontWeight="Bold" Foreground="DimGray" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtPrice" Text="0원" FontSize="16" FontWeight="Heavy" Foreground="#FF5A45" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,1,0,1" Padding="0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnMinus" Width="35" Height="35" Padding="0" Background="#EEEEEE" BorderBrush="{x:Null}" Foreground="DimGray" Click="BtnMinus_Click">
                        <iconPacks:PackIconBootstrapIcons Kind="Dash" Width="20" Height="20"/>
                    </Button>

                    <TextBlock x:Name="TxtQuantity" Text="1" FontSize="20" FontWeight="Bold" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>

                    <Button x:Name="BtnPlus" Width="35" Height="35" Padding="0" Background="#FF5A45" BorderBrush="{x:Null}" Foreground="White" Click="BtnPlus_Click">
                        <iconPacks:PackIconBootstrapIcons Kind="Plus" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="취소" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Gray" Margin="0,0,5,0" Click="BtnCancel_Click"/>
                <Button Grid.Column="1" Content="주문 담기" Background="#FF5A45" BorderBrush="{x:Null}" FontWeight="Bold" Click="BtnConfirm_Click"/>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>